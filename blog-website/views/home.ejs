<%- include("partials/head") %>
<%- include("partials/header") %>
    <div class="page-wrapper">
        <% if (slider) { %>
        <div class="post-slider">
            <h1 class="slider-title">Trending posts</h1>
            <i class="fas fa-chevron-left prev"></i>
            <i class="fas fa-chevron-right next"></i>
            <div class="post-wrapper">
                <% trending.forEach(function (post) { %>
                <div class="post">
                    <img src="/<%= post.image %>" alt="" class="slider-image">
                    <div class="post-info">
                        <h4><a href="/post/<%= post.slug %>"><%= post.title %></a></h4>
                        <span class="post-meta"><i class="far fa-user"></i> <%= post.username %></span>
                        <span class="post-meta"><i class="far fa-calendar"></i> <%= formatDate(post.created_at) %></span>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>
        <div class="content clearfix">
            <div class="main-content">
                <h1 class="recent-post-title">
                    <% if (q) { %>Results for “<%= q %>”<% } else if (topic) { %><%= topic.name %><% } else { %>Recent posts<% } %>
                </h1>
                <% if (!posts.length) { %>
                <div class="section" style="background: white; padding: 24px; border-radius: 5px;">
                    <p>No published posts match that search.</p>
                </div>
                <% } %>
                <% posts.forEach(function (post) { %>
                <div class="post">
                    <img src="/<%= post.image %>" alt="" class="post-image">
                    <div class="post-preview">
                        <h2><a href="/post/<%= post.slug %>"><%= post.title %></a></h2>
                        <span class="post-meta"><i class="far fa-user"></i> <%= post.username %></span>
                        <span class="post-meta"><i class="far fa-calendar"></i> <%= formatDate(post.created_at) %></span>
                        <% if (post.topic_name) { %>
                        <span class="post-meta"><i class="far fa-folder"></i> <%= post.topic_name %></span>
                        <% } %>
                        <p class="preview-text"><%= post.body.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 160) %></p>
                        <a href="/post/<%= post.slug %>" class="btn read-more">Read more</a>
                    </div>
                </div>
                <% }) %>
            </div>
            <div class="sidebar">
                <div class="section search">
                    <h2 class="section-title">Search</h2>
                    <form action="/" method="get">
                        <% if (topic) { %><input type="hidden" name="topic" value="<%= topic.id %>"><% } %>
                        <input type="text" name="q" value="<%= q %>" class="text-input" placeholder="Search...">
                    </form>
                </div>
                <div class="section topics">
                    <h2 class="section-title">Topics</h2>
                    <ul>
                        <li><a href="/">All topics</a></li>
                        <% topics.forEach(function (item) { %>
                        <li><a href="/?topic=<%= item.id %>"><%= item.name %></a></li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
<%- include("partials/footer") %>
