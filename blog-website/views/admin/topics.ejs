<%- include("../partials/head") %>
<%- include("../partials/admin-header") %>
            <div class="button-group">
                <a href="/admin/topics/new" class="btn btn-big">Add Topic</a>
                <a href="/admin/topics" class="btn btn-big">Manage Topics</a>
            </div>
            <div class="content">
                <h2 class="page-title">Manage Topics</h2>
                <table>
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>Name</th>
                            <th colspan="2">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% topics.forEach(function (topic, index) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= topic.name %></td>
                            <td><a href="/admin/topics/<%= topic.id %>/edit" class="edit">edit</a></td>
                            <td>
                                <form action="/admin/topics/<%= topic.id %>/delete" method="post">
                                    <input type="hidden" name="csrf" value="<%= csrf %>">
                                    <button class="delete link-button" type="submit">delete</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
<%- include("../partials/admin-footer") %>
